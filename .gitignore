# MarkItDown Flow 2.0.0 (clean-room shell under shell/, engine under engine/)

# Build outputs: the community-install bundle is produced by `shell/esbuild.config.mjs` and attached to releases.
/main.js
*.map
build/
dist/
engine/dist/
*.whl
*.zip

# Dependencies and caches
node_modules/
__pycache__/
.pytest_cache/
engine/pytest-cache-files-*/
*.egg-info/

# Local vault data and worktrees (never committed; data.json holds user settings)
data.json
.claude/worktrees/
.peerhub/

# Editors and OS
.idea
*.iml
.vscode
.DS_Store
