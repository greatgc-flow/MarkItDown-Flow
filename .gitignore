# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Build artifacts
release/
clean-release/
*.zip
test-extract/
.claude/worktrees/

# Auto-generated bundled Python sources (regenerated by scripts/generate-bundled-scripts.mjs
# on every npm dev/build/test). Single source of truth is python/*.py.
src/utils/bundledPythonScripts.generated.ts

# Python cache directories produced by py_compile / direct invocation
python/__pycache__/
